{
  "name": "@talkio/testkit",
  "version": "1.0.0-alpha.1",
  "description": "Testing utilities and simulators for Talkio voice agents",
  "keywords": [
    "conformance",
    "simulator",
    "talkio",
    "testing",
    "voice-ai"
  ],
  "homepage": "https://github.com/abdufelsayed/voice-ai/tree/main/packages/testkit#readme",
  "bugs": {
    "url": "https://github.com/abdufelsayed/voice-ai/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdufelsayed/voice-ai.git",
    "directory": "packages/testkit"
  },
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:stress": "PATH=\"$HOME/.bun/bin:$PATH\" bun scripts/stress.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "clean": "git clean -xdf node_modules dist .turbo .tsbuildinfo"
  },
  "dependencies": {
    "@xstate/graph": "^3.0.4",
    "fast-check": "^4.7.0",
    "xstate": "^5.31.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.0",
    "@talkio/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "talkio": "workspace:*",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "talkio": ">=1.0.0-alpha.1"
  },
  "engines": {
    "node": ">=20"
  }
}
